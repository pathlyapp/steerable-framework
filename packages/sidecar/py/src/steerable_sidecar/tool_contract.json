{
  "edit": {
    "atomic": true,
    "errorCodes": [
      "empty_old",
      "no_edits",
      "ambiguous",
      "not_found",
      "overlap"
    ],
    "matchLevels": [
      "exact",
      "trim",
      "unicode"
    ],
    "newField": "newText",
    "oldField": "oldText",
    "overlap": "reject"
  },
  "tools": {
    "bash": {
      "desktopName": "local_exec_shell",
      "requiredInput": [
        "command"
      ],
      "requiredResult": [
        "exitCode",
        "stdout",
        "stderr"
      ]
    },
    "edit_file": {
      "desktopName": "local_edit_file",
      "optionalInput": [
        "expectedVersion"
      ],
      "requiredInput": [
        "path",
        "edits"
      ],
      "requiredResult": [
        "version",
        "diff",
        "applied",
        "matches"
      ]
    },
    "read_file": {
      "desktopName": "local_read_file",
      "requiredInput": [
        "path"
      ],
      "requiredResult": [
        "content",
        "version"
      ]
    },
    "write_file": {
      "desktopName": "local_write_file",
      "optionalInput": [
        "expectedVersion"
      ],
      "requiredInput": [
        "path",
        "content"
      ],
      "requiredResult": [
        "version"
      ]
    }
  },
  "version": 1,
  "versionAlgorithm": "sha256-utf8-hex",
  "versionToken": {
    "inputField": "expectedVersion",
    "onConflict": "reject",
    "resultField": "version"
  },
