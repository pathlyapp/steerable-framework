{
  "name": "steerable-example-web-shell",
  "version": "0.0.0",
  "private": true,
  "description": "Steerable framework reference web app: ChatPanel + 14 rich cards + canned fixtures + (optional) sidecar transport. Zero external deps in mock mode.",
