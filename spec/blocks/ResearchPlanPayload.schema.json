{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steerable.dev/spec/blocks/ResearchPlanPayload.schema.json",
  "title": "ResearchPlanPayload",
  "description": "Payload of a research-plan card. Snapshots a research agent's current sub-question tree and its decision for the next round. The UI shows each sub-question with kind / evidence-strength badges.",
  "type": "object",
  "additionalProperties": true,
  "required": ["topic", "round", "final", "subQuestions", "decision"],
  "properties": {
    "topic": { "type": "string" },
    "round": { "type": "integer", "minimum": 0 },
    "final": { "type": "boolean", "description": "True when the research loop is complete and this snapshot is the last one." },
    "subQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "question", "kind", "status", "evidenceCount"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "kind": { "type": "string", "enum": ["fact", "compare", "conclusion", "risk"] },
          "status": {
            "type": "string",
            "enum": ["pending", "searching", "evidenced_strong", "evidenced_medium", "evidenced_weak", "conflicted", "exhausted"]
          },
          "evidenceCount": { "type": "integer", "minimum": 0 },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": true,
      "required": ["next"],
      "properties": {
        "next": { "type": "string", "enum": ["continue", "expand", "converge"] },
        "reason": { "type": ["string", "null"] }
      }
    }
  }
}
